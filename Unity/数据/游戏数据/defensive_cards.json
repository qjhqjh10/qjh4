{
 "_schema": "defensive_cards/v1 —— 防御卡数据表（原版 `EnviromentalEffectCardsSO.enviromentalEffects[].defensiveCards`），每阵营一组。由 d:/4/Unity/工具/gen_defensive_cards.py 生成，可重跑。",
 "_sources": {
  "SO": "d:/4/Unity/素材/Warpforge原版/游戏数据/去重定义/MonoBehaviour/EnvironmentalEffectCardsSO.json（= assets_full/bundle_duplicateassetisolationso_assets_all/…；资产名 `Environmental…` 比类名 `Enviromental…` 多一个 n）",
  "阵营号→阵营名": "d:/4/Unity/数据/游戏数据/offensive_cards.json 的 `armyId`（判据只留一处）"
 },
 "_fields": {
  "cardRef": "原版字段 `defensiveCard` 的原始 PPtr（`m_FileID` 恒 4 = 外部文件）",
  "forgeLevel": "原版字段（解锁档；13 个阵营现读全是 [1, 20, 40]）",
  "idx": "槽序（= `defensiveCards` 数组下标，⛔ 不代表卡名顺序）",
  "cardName": "**一律 null** —— 见 _unresolved"
 },
 "_unresolved": {
  "cardName": "`defensiveCard` 的 `m_FileID` 恒 4 = 外部文件，解包 JSON 没有 externals 表；卡数据在原版远端 CCD ⇒ PathID 解不出名字",
  "卡面贴图 / 候选卡名": "`offensive_cards.json` 抽到的 52 张贴图（39 张进攻卡面 + 13 个默认）是**进攻那一套**；防御卡是**普通卡**（`defensiveCard` 指向 RawCardScript），它们的卡面混在同阵营卡图里（每个 cardassets 包 91–112 张）⇒ **按 PathID 定位不到具体哪张** ⇒ 进攻侧那条「按贴图名反推候选卡名」的路在防御侧**走不通**（🔴 2026-10-27 就地订正：本行原先写「没有防御卡那一份贴图」，那是从 52 = 13×4 推的，**证据只够说「进攻表里没抽到」，不够说「资产里没有」**）"
 },
