<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>wfprobe</AssemblyName>
    <RootNamespace>wfprobe</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <!-- 只编下面显式列出的文件 + RuleEngine/Core/*.cs，不带别的 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>0169,0649,0414,0219,0067,CS8632</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本工具的壳（已从 D:/tmp/wf_b14_probe 收编进仓库） -->
    <Compile Include="Stub.cs" />
    <Compile Include="FilterAdd.cs" />
    <Compile Include="BattleProbe.cs" />
    <Compile Include="Scan.cs" />
    <!-- 🆕 `layers`（`A1877①`，2026-10-14）：`AuraSpecs` / `keywords` / 执行层 ops 的 JSONL dump 口。
         ⚠️ **必须显式列进来** —— 本 csproj 关掉了 `EnableDefaultCompileItems`，漏了就**编不进去、
         而调用点会在运行时抛**（同族：`Stub.cs` 被拿掉 ⇒ 18 个 `CS0103`，见文件末那段注释）。 -->
    <Compile Include="Layers.cs" />
    <Compile Include="WillRun.cs" />
    <Compile Include="FaithProbe.cs" />
    <Compile Include="PlayProbe.cs" />
    <!-- 🆕 `a24`（2026-10-24 · 引擎线第四批）：`T21④` 回合末发射序 + `新账-104` `EC58` 双子部署的离线真跑 -->
    <Compile Include="A24Probe.cs" />
    <!-- 🆕 `g2`（2026-10-24 · 引擎线剩余三件）：`D8` `ThisUnitSummoned` · `D9` `WhileInPlay` ·
         `questTimes` 消费点的离线真跑。⚠️ 本 csproj 关了 `EnableDefaultCompileItems` ⇒ 漏了这行
         构建会报 `CS0103 名称"G2Probe"`（不是运行时）。 -->
    <Compile Include="G2Probe.cs" />
    <!-- 🆕 `n2`（2026-10-24 · 引擎线 `新账-95` #2 的红灯诊断）：`role=mult` 结构化乘数的离线读数。
         ⚠️ 本 csproj 关了 `EnableDefaultCompileItems` ⇒ 漏了这行构建会报 `CS0103 名称"N2Probe"`。 -->
    <Compile Include="N2Probe.cs" />
    <!-- 🆕 `nonkw`（`A1462`）—— `non <关键词>` 的目标筛选专用探针，见 `NonKwProbe.cs` 头注 -->
    <Compile Include="NonKwProbe.cs" />
    <Compile Include="Program.cs" />
    <!-- 🆕 `dbparse`（`E12`，2026-10-19 · 第五十七会话）：**`CardDatabase.Parse` 的形状 + 耗时**。
         🔴 为此**必须**把 `Data/CardDatabase.cs` 也编进来 —— 本 csproj 关了
         `EnableDefaultCompileItems`，只编显式列出的文件；漏了它，`DbParse.cs` 会在**构建时**报
         `CS0246 CardDatabase`（不是运行时）。⚠️ 它**只碰** `UnityEngine.Resources` / `TextAsset` /
         `Debug` / `JsonUtility` 四个成员 —— 全在 `Stub.cs` 里（`CardDatabase.Load` 走 `Resources`，
         `Parse` 走 `JsonUtility`；探针只调 `Parse`）。
         ⚠️ `Data/` 下**别的文件不要顺手加进来**：`DeckStore` 要 `persistentDataPath`，探针没有。 -->
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/CardDatabase.cs" />
    <Compile Include="DbParse.cs" />
    <!-- 🆕 `ai`（`R11`，2026-10-25 · 第八十会话）：AI 打分的**逐条贡献**读数口。
         🔴 为什么必须把下面四个 `Data/` 文件编进来：`play all dump` 是**结算层**读数、
         **结构上看不见 AI**（实测只改 AI 打分时它前后逐字节相同）⇒ 在那之前 AI 改动没有读数口。
         · `SimpleAI.cs` —— `ScoreFromAttack` / `ScoreDamaging` / `ScoreWarlordDamage` / `ValueInPlay`
         · `AiScoring.cs` —— `ScoreFromCriteria`（逐条贡献就从它的返回值来）
         · `AiTargets.cs` —— `GetTargets` / `MatchesTarget` / `MightAct`
         · `AiScoringData.cs` —— 只用它的 **DTO 类型**（`ai_scoring.json` 由探针自己读文件，
           **不走**它的 `Resources.Load` 装载口 —— 探针里那是桩、恒 null）
         ⚠️ 这四个文件对 Unity 类型的依赖只有 `Debug` / `Resources` / `JsonUtility` / `TextAsset`
         ＋ [`RuntimeInitializeOnLoadMethod`]（`SimpleAI.cs:1940`）—— 全部在 `Stub.cs` 里。
         ⛔ `Data/` 下**别的文件别顺手加**（`DeckStore` 要 `persistentDataPath`，探针没有）。 -->
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/SimpleAI.cs" />
    <!-- 🆕 2026-10-27（`B88_E3`）：`SimpleAI` 的兄弟分册（第 ④ 档主动能力的 AI 候选枚举）。
         🔴 必须显式列 —— 本 csproj 关了 `EnableDefaultCompileItems`，漏了就是构建期
         `CS0103 名称"AddActiveAbilityEntry"`（`SimpleAI.cs:421` 调用它）。 -->
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/SimpleAI.ActiveEntry.cs" />
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/AiScoring.cs" />
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/AiTargets.cs" />
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/AiScoringData.cs" />
    <!-- 🆕 2026-10-29（调度台 · 同步点）：`Data/` 是**逐个列举**（`Core/` 才是通配 `*.cs`），
         所以写手新建的 Data partial 不加进来就是构建期 `CS0103`：
           · `CardDatabasePartial_B97W5.cs` ⇒ `MapBoardGateWithConditions` / `MapStartingCardInHand`
                      · `SimpleAI.StableSort.cs`       ⇒ `StableSortByScoreDesc`（账 `:40` 稳定排序）
         🔴 **以后任何新增的 `Data/*.cs` 都要在这里补一行** —— 漏了就是「探针读不出数」而不是「代码错」。 -->
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/CardDatabasePartial_B97W5.cs" />
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/CardDatabasePartial_B98H7.cs" />
    <Compile Include="../../MyGame/Assets/RuleEngine/Data/SimpleAI.StableSort.cs" />
    <Compile Include="AiProbe.cs" />
    <!-- 🆕 `tutorial`（`G5`，2026-10-26 · 第 5 轮）：**教程局读数口**。
         🔴 它修的是 `F4_第4轮.md` §1·3 那一类「12 条 `AiScripted` 全卡在 G3（可观察量）」——
         `ruleprobe` 结构上看不见教程局（没有「局」也没有关卡数据）。
         ⚠️ 它**不需要**新增编译项：`Core/TutorialScript.cs` 早就在 `Core/*.cs` 里，
         关卡数据由探针自己读 `Resources/tutorial_stages.json` + `TutorialData.Install(...)` 装上。
         ⛔ 别把 `Data/TutorialDatabase.cs` 加进来（那半个 partial 走 `Resources.Load`，探针里是桩）。 -->
    <Compile Include="TutorialProbe.cs" />
    <!-- 🆕 `traits`（`B8_AH`，2026-10-26）：**trait 家族（`CardTraits +0x230`）＋ `keyword(+0x98)`** 的读数口。
         🔴 为什么必须显式列进来：本 csproj 关了 `EnableDefaultCompileItems`（漏了 = 构建期 `CS0103 名称"TraitsProbe"`）。
         ⚠️ 它**不需要**新增别的编译项：`CardDatabase.cs`（上面已列）＋ `Core/*.cs`（`CardDef` / `ConditionEval`）
         就够；它走 `CardDatabase.Parse` 真实装载链 ⇒ 量得到 `cardTraits` / `keyword` 两列的透传。 -->
    <Compile Include="TraitsProbe.cs" />
    <!-- 被测对象：相对路径（原来写死 D:/4/... 绝对路径 ⇒ 换机器/换盘就编不过）。
         🔴 从 工具/ruleprobe/ 上去两级才是 Unity/ ⇒ ../../MyGame/... -->
    <Compile Include="../../MyGame/Assets/RuleEngine/Core/*.cs" />
  </ItemGroup>
  <!-- 🔴 不要加 <DefineConstants>UNITY_5_3_OR_NEWER</DefineConstants>。
       ⚠️ 2026-10-18 更新（`A941` 之后）：`TutorialScript.cs` 那圈 `#if` 装载支已整段搬进
       `Data/TutorialDatabase.cs`（用「半个 partial 方法」换乘：无实现 ⇒ 编译器把调用点一起抹掉
       ⇒ 探针自动落回兜底）。
       🔴 2026-10-12 更正（`A1478` · 现核）：**原来这里写的是「Core 里已经没有任何 Unity 类型了」
       —— 今天不成立。** `Core/*.cs` 里仍然**裸用 `UnityEngine.Debug`**：把 `Stub.cs` 从编译项
       拿掉，`dotnet build` 实测 **18 个 `CS0103`（当前上下文中不存在名称"UnityEngine"）落在 6 个文件**：
         · `BattleContext.cs:771` `:1538` · `BoardSlots.cs:163` · `CardInstance.cs:208`
         · `GameplayVariables.cs:76` · `RuleCore.cs:558` `:668` `:681` `:714` `:722`
         · `TutorialScript.cs:436` `:832` `:1019` `:1031` `:1049` `:1283` `:1292` `:1332`
       （`grep -n "UnityEngine\." Core/*.cs` 的其余命中**全在注释里**，不参与编译。）
       ⇒ **探针能单独编 `Core`，靠的是下面那份 `Stub.cs` 桩**（`Debug`/`Random`/`Resources`/
       `JsonUtility`/`TextAsset` 五个成员），⛔ **不是**「Core 已经干净」。
       🔴 **谁把 `Stub.cs` 从编译项里拿掉，就会看到上面那 18 个错** —— 那不是引擎坏了，是桩没了。
       ⚠️ **错因**：写上面那条注释时只核了「`#if` 装载支搬走了」（真），把它当成了「Unity 类型没了」（假）；
       而 `Data/TutorialDatabase.cs` 那一跳只解释了 `Resources`/`JsonUtility`，**没有**、也管不到
       `UnityEngine.Debug`。
       ⇒ 定义 `UNITY_5_3_OR_NEWER` **今天确实不再有任何影响**（现测：加上它仍 **0 错 0 告警**
       —— `Core/*.cs` 里现在一个 `#if` 都不剩）。**仍然别定义**的理由不是「怕它今天出事」，
       而是：`Core/` 里**写回 `#if UNITY_5_3_OR_NEWER` 双分支**这件事本身就是本仓红线
       （`TutorialScript.cs:384` 写着「⛔ 不许在 `Core/` 里写回 `Resources`/`JsonUtility`/`TextAsset`，
       哪怕又包一层 `#if`」）—— 探针**故意一个符号都不定义**（Unity 侧 `_wfcheck.csproj` 定义了 300+ 个），
       谁再往 `Core/` 里写回一条 `#if`，探针就会**走兜底那半**、当场看得出，而不是被一个符号盖过去。 -->
</Project>
